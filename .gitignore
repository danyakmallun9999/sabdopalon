# Binaries
/sabdopalon
/sabdopalon.exe
*.exe
*.dll
*.so
*.dylib

# Downloaded packages (installed via 'sabdopalon add', not committed)
/bin/

# Runtime data (never commit)
/data/
/logs/
/tmp/
/backups/

# SSL certs (generated locally)
/certs/*.pem
/certs/*.crt
/certs/*.key
/certs/*.csr

# Generated vhost configs
/config/vhosts/*.conf

# Generated PHP routers (auto-created by proxy)
/sites/*/.sabdopalon-router.php

# Go
/vendor/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Deleted sites (dashboard moves folders here instead of rm -rf)
/sites/.trash/

# Dashboard React UI (build artifacts — commit only the placeholder)
/internal/dashboard/ui/node_modules/
/internal/dashboard/ui/dist/*
!/internal/dashboard/ui/dist/
!/internal/dashboard/ui/dist/index.placeholder.html

# Desktop (Tauri) — built sidecar binaries, target dir, generated schemas,
# and downloaded core-stack resources (populated by CI)
/desktop/src-tauri/binaries/*
/desktop/src-tauri/target/
/desktop/src-tauri/gen/
/desktop/src-tauri/resources/core/**
!/desktop/src-tauri/resources/core/.gitkeep
/desktop/node_modules/
