# Per-site overrides for Sabdopalon (optional).
# Place this file inside sites/<your-site>/.sabdopalon.yml
#
# php:      a version installed via `sabdopalon add php@<ver>` ("8.2"),
#           or an absolute path / PATH command name.
# docroot:  document root relative to this folder (default: public/ if it exists)
# database: per-site engine override label (informational)
# aliases:  extra hostnames routed to this site automatically
# env:      custom environment variables injected into PHP

php: ""
docroot: ""
aliases: []
env:
  APP_ENV: local
